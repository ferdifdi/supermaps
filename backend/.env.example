# GEO MAPID keys (Dashboard -> Map Services -> API Keys). Create 3 separate keys.
MAPID_BASEMAP_KEY=
MAPID_DATA_KEY=
MAPID_CATALOGUE_KEY=

# Groq (free) for AI narrative. https://console.groq.com/keys
GROQ_API_KEY=

# Public base URL of this backend, used to rewrite basemap style.json so the key stays server side.
PUBLIC_BASE_URL=http://localhost:8000

# Optional: OpenAQ (free) PM2.5 comfort factor for M-UC1 routing. https://explore.openaq.org/register
# Without a key, air quality is simply skipped (comfort_factor stays 1.0, air_quality: null).
OPENAQ_API_KEY=

# Optional: OpenWeatherMap (free) current temperature/feels-like for M-UC1's walk summary.
# https://home.openweathermap.org/api_keys
# Without a key, weather is simply skipped (weather: null).
OPENWEATHER_API_KEY=

# Optional: GeoJSON OPEN API URLs of MAPID Data Catalogue layers imported into your project.
# Premium Data is sliced per kabupaten/kota, so give each dataset its list of slice URLs
# separated by "|" - they get merged into one FeatureCollection.
# Format: name=url1|url2|url3,name2=url1|url2
MAPID_LAYER_URLS=
